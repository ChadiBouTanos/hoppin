#############################
# Python / Django ignores
#############################

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual environments
.venv/
venv/
env/

# Django stuff
*.log
db.sqlite3
backend/db.sqlite3
backend/db.sqlite3-journal
media/
staticfiles/

# Ignore SQLite journal files
*.sqlite3-journal


#############################
# Environment variables
#############################
.env
*.env
.env.*
.env.local


#############################
# Node / React ignores
#############################
node_modules/
dist/
build/
.cache/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*


#############################
# VS Code / IDE files
#############################
.vscode/
.idea/
*.swp
*.swo


#############################
# OS generated files
#############################
.DS_Store
Thumbs.db
